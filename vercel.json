{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "vite",
      "buildCommand": "npm run build -- --base=/admin/",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/admin/:path*", "destination": "/:path*" },
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "api",
      "framework": "express",
      "entrypoint": "app.js",
      "rewrites": [
        { "source": "/api/:path*", "destination": "/:path*" }
      ]
    },
    "client": {
      "root": "front/client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "server": {
      "root": "front/server",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    { "source": "/socket.io/:path*", "destination": { "service": "server" } },
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/admin/:path*", "destination": { "service": "admin" } },
    { "source": "/auth/:path*", "destination": { "service": "admin" } },
    { "source": "/demo/:path*", "destination": { "service": "admin" } },
    { "source": "/img/:path*", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
